# Port HTTP service (harus cocok dengan WA_BOT_URL di backend/.env)
PORT=3005
# Alamat bind. Lokal: 127.0.0.1. Railway/container: WAJIB 0.0.0.0.
HOST=127.0.0.1

# Secret bersama — WAJIB sama dengan WA_BOT_SECRET di backend/.env.
# Buat nilai acak baru, jangan pakai contoh ini:
#   openssl rand -hex 32
WA_SECRET=ganti-dengan-secret-acak-yang-sama-dengan-backend

# Folder sesi WhatsApp (creds + pre-key). Di Railway arahkan ke volume:
# WA_AUTH_DIR=/data/auth
# WA_AUTH_DIR=./auth

# Opsional: nomor WhatsApp dalam format 628xxxx untuk login tanpa QR
# (pairing code muncul di terminal, dikirim sekali). Nomor ini HARUS sama
# dengan nomor WhatsApp di HP yang memasukkan kode.
# WA_PAIRING_NUMBER=6281234567890

# Berapa lama satu QR berlaku (ms) sebelum diganti yang baru.
WA_QR_TIMEOUT_MS=120000
# Gambar QR terbaru ditulis ke berkas ini. Default: wa-bot/qr.png
# Di Railway arahkan ke volume: WA_QR_FILE=/data/qr.png
# WA_QR_FILE=/path/ke/qr.png

# Jeda minimal (ms) antar pesan keluar — pelan = aman dari pembatasan WA.
WA_SEND_DELAY_MS=1500

# Level log Baileys: silent | error | warn | info | debug
WA_LOG_LEVEL=warn
