# Environment produksi untuk deploy di Render (demo).
# Dipakai oleh build command di render.yaml (`cp .env.render .env`).
# APP_KEY sengaja dikosongkan: bila tidak diset di dashboard Render,
# build akan membuatnya otomatis (berubah tiap deploy — cukup untuk demo).

APP_NAME="E-Presensi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://presensi-api-production.up.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Log keluar ke stdout/stderr agar terbaca panel Render.
LOG_CHANNEL=stderr
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# SQLite: file dibuat saat build (database/database.sqlite).
# Catatan: disk Render bersifat sementara — database di-reset saat deploy ulang /
# restart. Cukup untuk demo; jalankan ulang build (atau seed) bila perlu.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Tanpa worker di plan gratis: kirim notifikasi secara sinkron.
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Akun admin tetap (hanya satu) — dibuat oleh UserSeeder.
ADMIN_NAME="Andi Pratama"
ADMIN_EMAIL=andi.pratama@sekolah.id
ADMIN_PASSWORD=password

# Akun petugas demo (akun petugas lain dibuat lewat panel admin).
PETUGAS_NAME="Bagus Wijaya"
PETUGAS_EMAIL=bagus.wijaya@sekolah.id
PETUGAS_PASSWORD=password

# Akun siswa demo (login portal mobile: NIS + PIN).
STUDENT_NIS=2024000
STUDENT_NAME="Ahmad Fauzi"
STUDENT_PIN=2024000

# Notifikasi WhatsApp dimatikan untuk demo (service wa-bot tidak dideploy).
WA_ENABLED=false
APP_TIMEZONE=Asia/Jakarta
